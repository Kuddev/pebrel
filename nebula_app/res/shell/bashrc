# Integration is per shell process. Re-sourcing must not repeat user startup or
# duplicate PS0/PROMPT_COMMAND entries. A child shell has a different BASHPID.
if [[ ${__pebrel_integration_pid:-} == ${BASHPID:-$$} ]]; then
    return
fi
__pebrel_integration_pid=${BASHPID:-$$}

if [[ ${PEBREL_REMOTE_LOGIN:-0} == 1 ]]; then
    # Startup source observation: Copyright 2026 l0ng-ai, Apache-2.0.
    # See THIRD-PARTY-NOTICES; Pebrel supplies the lifecycle/prompt integration.
    unset PEBREL_REMOTE_LOGIN
    # --rcfile is ignored by bash -l. Replay login startup, observing whether
    # it already sourced .bashrc. This is an interactive rcfile shell; Bash's
    # read-only login_shell flag cannot be enabled by shopt.
    __pebrel_rc_seen=0
    source() { case ${1-} in */.bashrc|.bashrc) __pebrel_rc_seen=1;; esac; builtin source "$@"; }
    .() { case ${1-} in */.bashrc|.bashrc) __pebrel_rc_seen=1;; esac; builtin . "$@"; }
    if [[ -r /etc/profile ]]; then source /etc/profile; fi
    for __pebrel_profile in "$HOME/.bash_profile" "$HOME/.bash_login" "$HOME/.profile"; do
        if [[ -r $__pebrel_profile ]]; then source "$__pebrel_profile"; break; fi
    done
    unset -f source .
    if [[ $__pebrel_rc_seen == 0 && -r $HOME/.bashrc ]]; then source "$HOME/.bashrc"; fi
    unset __pebrel_rc_seen __pebrel_profile
elif [[ -r $HOME/.bashrc ]]; then
    source "$HOME/.bashrc"
fi

# Without a writable prompt hook, PS0 alone would start commands that can never
# emit their completion. Leave this shell to the non-integrated fallback.
if [[ $(declare -p PROMPT_COMMAND 2>/dev/null) =~ ^declare\ -[^[:space:]]*r ]]; then
    return
fi

# Keep this visual prompt scoped to Pebrel's temporary SSH shell, and only
# replace Bash's default prompt. User prompt frameworks remain in control.
if [[ ${PEBREL_REMOTE_SESSION:-0} == 1 && ${PEBREL_REMOTE_POWERLINE:-1} == 1 \
    && -z ${STARSHIP_SHELL:-} && -z ${POSH_SHELL:-} \
    && ${PS1-} == *'\u@\h'*':'*'\w'* ]]; then
    __pebrel_ssh_prompt_enabled=1
    __pebrel_ssh_prompt_last_ps1=$PS1
    if ! declare -F clear >/dev/null && ! alias clear >/dev/null 2>&1; then
        clear() {
            command clear "$@"
            local clear_status=$?
            __pebrel_ssh_prompt_count=0
            return "$clear_status"
        }
    fi
fi

__pebrel_shell_token=$(printf '%s' "${WSL_DISTRO_NAME:+wsl|${WSL_DISTRO_NAME}|}bash:${HOSTNAME:-localhost}:${BASHPID:-$$}:$RANDOM" | base64 | tr -d '\r\n')

_nebula_cwd() {
    local LC_ALL=C cwd_value=$PWD encoded='' character ordinal index
    for ((index=0; index<${#cwd_value}; index++)); do
        character=${cwd_value:index:1}
        case $character in
            [a-zA-Z0-9/._~-]) encoded+=$character ;;
            *) printf -v ordinal '%02X' "'$character"; encoded+="%$ordinal" ;;
        esac
    done
    printf '\e]7;file://localhost%s\a' "$encoded"
}

_nebula_preexec() {
    if [[ ${_nebula_at_prompt:-0} == 1 && $BASH_COMMAND != __pebrel_prompt_status=* ]]; then
        _nebula_at_prompt=0
        _nebula_command_running=1
        printf '\e]133;C\a'
    fi
}

_nebula_capture_status() {
    _nebula_last_status=${1:-$?}
    if [[ ${_nebula_native_preexec:-0} == 1 ]]; then
        _nebula_command_running=${_nebula_at_prompt:-0}
    fi
    _nebula_at_prompt=0
    return "$_nebula_last_status"
}

_nebula_precmd() {
    printf '\e]1337;SetUserVar=pebrel_shell=%s\a' "$__pebrel_shell_token"
    if [[ ${_nebula_command_running:-0} == 1 ]]; then
        printf '\e]133;D;%s\a' "$_nebula_last_status"
    fi
    _nebula_command_running=0
    _nebula_cwd
    printf '\e]133;A\a'
    if [[ ${__pebrel_ssh_prompt_enabled:-0} == 1 ]]; then
        if [[ ${PS1-} != "$__pebrel_ssh_prompt_last_ps1" ]]; then
            __pebrel_ssh_prompt_enabled=0
        else
            local branch='' git_segment='' leading_newline=''
            branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || branch=
            if [[ -n $branch ]]; then
                git_segment=" \\[\\e[38;5;6m\\] $branch  \\[\\e[0m\\]"
            fi
            if [[ ${__pebrel_ssh_prompt_count:-0} -gt 0 ]]; then
                leading_newline='\n'
            fi
            __pebrel_ssh_prompt_count=$(( ${__pebrel_ssh_prompt_count:-0} + 1 ))
            PS1="$leading_newline\\[\\e[38;5;4m\\]\\[\\e[48;5;4m\\]\\[\\e[38;5;0m\\]  \\[\\e[0m\\]\\[\\e[38;5;4m\\]\\[\\e[0m\\]  \\w  $git_segment \\[\\e[38;5;6m\\]  \\D{%H:%M:%S}  \\[\\e[0m\\]\\n\\n\\[\\e[35m\\]❯\\[\\e[0m\\] "
            __pebrel_ssh_prompt_last_ps1=$PS1
        fi
    fi
    _nebula_at_prompt=1
    return "$_nebula_last_status"
}

if ((BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4))); then
    _nebula_native_preexec=1
    PS0=$'\e]133;C\a'${PS0-}
elif [[ -z $(trap -p DEBUG) ]]; then
    trap '_nebula_preexec' DEBUG
fi
__pebrel_capture='__pebrel_prompt_status=$?; if declare -F _nebula_capture_status >/dev/null 2>&1; then _nebula_capture_status "$__pebrel_prompt_status"; fi'
__pebrel_prompt='if declare -F _nebula_precmd >/dev/null 2>&1; then _nebula_precmd; fi'
if [[ $(declare -p PROMPT_COMMAND 2>/dev/null) =~ ^declare\ -[^[:space:]]*a ]]; then
    PROMPT_COMMAND=("$__pebrel_capture" "${PROMPT_COMMAND[@]}" "$__pebrel_prompt")
else
    PROMPT_COMMAND="$__pebrel_capture"$'\n'"${PROMPT_COMMAND-}"$'\n'"$__pebrel_prompt"
fi
unset __pebrel_capture __pebrel_prompt
