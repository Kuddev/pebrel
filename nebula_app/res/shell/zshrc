if [[ $NEBULA_ZDOTDIR_WAS_SET == 1 ]]; then
    ZDOTDIR=$NEBULA_ORIGINAL_ZDOTDIR
    [[ ${NEBULA_ZDOTDIR_EXPORTED:-1} == 1 ]] || typeset +x ZDOTDIR
else
    unset ZDOTDIR
fi
if [[ ${skip_global_compinit-} == nebula-bootstrap ]]; then
    unset skip_global_compinit
    # Ubuntu's /etc/zsh/zshrc condition, now with the user's own dump directory;
    # the global rc only ran when GLOBAL_RCS was still set.
    if [[ -o globalrcs && -r /etc/os-release ]] &&
        (( ${${(@f)"$(</etc/os-release)"}[(I)ID*=*ubuntu]} )); then
        autoload -U compinit
        compinit
    fi
fi
if (( ${+_nebula_newuser} )); then
    unset _nebula_newuser
    if functions zsh-newuser-install >/dev/null 2>&1 ||
        autoload -U +X zsh-newuser-install 2>/dev/null; then
        zsh-newuser-install
    fi
fi
if [[ -r ${ZDOTDIR-$HOME}/.zshrc ]]; then
    source "${ZDOTDIR-$HOME}/.zshrc"
fi

# BSD ls accepts CLICOLOR without -G. Supply missing defaults after the user's
# rc file, preserving explicit values (including empty ones) and ls wrappers.
# Do not impose BSD flags on a GNU ls selected through the user's PATH.
if [[ "$OSTYPE" == darwin* && -z "$NO_COLOR" && "$TERM" != dumb ]]; then
    : ${CLICOLOR=1}
    : ${LSCOLORS=GxFxCxDxBxegedabagaced}
    export CLICOLOR LSCOLORS
fi

unset NEBULA_ZDOTDIR_WAS_SET NEBULA_ORIGINAL_ZDOTDIR NEBULA_ZDOTDIR_EXPORTED NEBULA_ZSH_INTEGRATION

__pebrel_shell_token=$(printf '%s' "${WSL_DISTRO_NAME:+wsl|${WSL_DISTRO_NAME}|}zsh:${HOST:-localhost}:$$:$RANDOM" | base64 | tr -d '\r\n')

_nebula_cwd() {
    emulate -L zsh
    local LC_ALL=C cwd_value=$PWD encoded='' character ordinal index
    for ((index=1; index<=${#cwd_value}; index++)); do
        character=${cwd_value[index]}
        case $character in
            [a-zA-Z0-9/._~-]) encoded+=$character ;;
            *) printf -v ordinal '%02X' "'$character"; encoded+="%$ordinal" ;;
        esac
    done
    printf '\e]7;file://localhost%s\a' "$encoded"
}

_nebula_preexec() {
    _nebula_command_running=1
    printf '\e]133;C\a'
}

_nebula_precmd() {
    local status_code=$?
    printf '\e]1337;SetUserVar=pebrel_shell=%s\a' "$__pebrel_shell_token"
    if [[ ${_nebula_command_running:-0} == 1 ]]; then
        printf '\e]133;D;%s\a' "$status_code"
    fi
    _nebula_command_running=0
    _nebula_cwd
    printf '\e]133;A\a'
    return "$status_code"
}

autoload -Uz add-zsh-hook
add-zsh-hook preexec _nebula_preexec
precmd_functions=(_nebula_precmd ${precmd_functions:#_nebula_precmd})
